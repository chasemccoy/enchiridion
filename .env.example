BACKEND_PORT=4321
FRONTEND_PORT=3456
DATABASE_NAME="enchiridion"
READWISE_TOKEN=""
OPENAI_API_KEY=

# Local web archives (record detail "Archive this page" action).
# ANTHROPIC_API_KEY drives the cleanup plan; archiving still works without it
# (falls back to heuristics). ARCHIVE_DIR is where archive folders are written
# (defaults to ~/Documents/Archives). ARCHIVE_BACKEND controls capture:
# 'playwright' (default — full render, runs JS and triggers lazy images),
# 'auto' (static fetch, escalate only if the page looks empty — faster but can
# under-capture JS/lazy pages), or 'fetch' (static only). ARCHIVE_INSECURE_TLS=1
# only if you sit behind a trusted TLS-intercepting proxy.
ANTHROPIC_API_KEY=
ARCHIVE_DIR=
ARCHIVE_BACKEND=
ARCHIVE_INSECURE_TLS=

# Set to 0 to stop new records from being auto-submitted to the Wayback
# Machine on creation (tests, offline work). The explicit `ench wayback
# archive` command ignores this flag.
WAYBACK_AUTO_ARCHIVE=

{
  "name": "enchiridion",
  "version": "0.1.0",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=24"
  },
  "description": "",
  "type": "module",
  "keywords": [],
  "author": "Chase McCoy",
  "license": "MIT",
  "bin": {
    "ench": "./backend/cli/ench/bin.js"
  },
  "scripts": {
    "cli": "tsx backend/cli/ench/index.ts",
    "lint": "prettier --write . && eslint . --fix && vue-tsc --noEmit",
    "dev:app": "vite --host",
    "dev:backend": "tsx watch backend/api/index.ts",
    "health-check": "tsx scripts/health-check.ts",
    "dev": "pnpm run health-check && concurrently \"pnpm run dev:app\" \"pnpm run dev:backend\"",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "db:push": "drizzle-kit push",
    "db:pull": "drizzle-kit push",
    "db:migrate": "pnpm drizzle-kit migrate",
    "db:generate": "pnpm drizzle-kit generate",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx backend/db/seed.ts",
    "db:clean": "rm -f enchiridion.db enchiridion.db-shm enchiridion.db-wal",
    "db:reset": "pnpm db:clean && pnpm db:push && pnpm db:seed",
    "db:check": "sqlite3 enchiridion.db 'PRAGMA integrity_check;'",
    "db:backup": "tsx scripts/backup-database.ts",
    "sync:readwise": "tsx scripts/sync-readwise.ts",
    "sync": "pnpm sync:readwise",
    "embed": "tsx scripts/embed-records.ts"
  },
  "dependencies": {
    "@nuxt/ui": "^4.8.1",
    "@tanstack/vue-query": "^5.80.6",
    "@types/multer": "^2.0.0",
    "@unhead/vue": "^2.0.10",
    "@vueuse/core": "^13.3.0",
    "better-sqlite3": "^12.10.0",
    "cors": "^2.8.5",
    "dompurify": "^3.4.7",
    "drizzle-orm": "1.0.0-rc.4-5d5b77c",
    "express": "^5.1.0",
    "markdown-it": "^14.2.0",
    "multer": "^2.0.1",
    "openai": "^6.39.1",
    "sharp": "^0.34.2",
    "slugify": "^1.6.6",
    "sqlite-vec": "^0.1.9",
    "tailwindcss": "^4.3.0",
    "trash": "^10.0.0",
    "vue": "^3.5.22",
    "vue-router": "4.6.3",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@eslint/js": "^9.28.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.2",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^24.7.1",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/tsconfig": "^0.8.1",
    "concurrently": "^9.1.2",
    "dotenv": "^17.2.3",
    "drizzle-kit": "1.0.0-rc.4-5d5b77c",
    "eslint": "^9.28.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-vue": "^10.1.0",
    "globals": "^16.2.0",
    "prettier": "^3.5.3",
    "tsx": "^4.20.6",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.0",
    "vite": "^7.1.9",
    "vue-tsc": "^3.1.1"
  }
}

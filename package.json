{
  "name": "enchiridion",
  "version": "0.1.0",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=24"
  },
  "description": "",
  "type": "module",
  "keywords": [],
  "author": "Chase McCoy",
  "license": "MIT",
  "bin": {
    "ench": "./backend/cli/ench/bin.js"
  },
  "scripts": {
    "cli": "tsx backend/cli/ench/index.ts",
    "lint": "prettier --check . && eslint . && vue-tsc -b",
    "fix": "prettier --write . && eslint . --fix && vue-tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev:app": "vite --host",
    "dev:backend": "tsx watch backend/api/index.ts",
    "health-check": "tsx scripts/health-check.ts",
    "dev": "pnpm run health-check && concurrently \"pnpm run dev:app\" \"pnpm run dev:backend\"",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "db:push": "drizzle-kit push",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:generate": "pnpm drizzle-kit generate",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx backend/db/seed.ts",
    "db:clean": "rm -f enchiridion.db enchiridion.db-shm enchiridion.db-wal",
    "db:reset": "pnpm db:clean && pnpm db:migrate && pnpm db:seed",
    "db:check": "sqlite3 enchiridion.db 'PRAGMA integrity_check;'",
    "db:backup": "tsx scripts/backup-database.ts",
    "sync:readwise": "tsx scripts/sync-readwise.ts",
    "sync": "pnpm sync:readwise",
    "embed": "tsx scripts/embed-records.ts",
    "archive:flatten": "tsx scripts/flatten-archives.ts"
  },
  "dependencies": {
    "@iconify/vue": "^5.0.3",
    "@nuxt/ui": "^4.11.2",
    "@tanstack/vue-query": "^5.104.0",
    "@types/multer": "^2.2.0",
    "@unhead/vue": "^3.4.1",
    "@vueuse/core": "^14.4.0",
    "amber": "link:../amber",
    "better-sqlite3": "^13.0.3",
    "compression": "^1.8.2",
    "cors": "^2.8.6",
    "dompurify": "^3.4.16",
    "drizzle-orm": "1.0.0-rc.4",
    "express": "^5.2.1",
    "markdown-it": "^14.3.2",
    "markdown-it-mark": "^4.0.0",
    "multer": "^2.4.0",
    "openai": "^6.49.0",
    "overtype": "^2.5.0",
    "sharp": "^0.34.5",
    "slugify": "^1.6.9",
    "sqlite-vec": "^0.1.9",
    "tailwindcss": "^4.3.3",
    "trash": "^10.1.1",
    "vue": "^3.5.43",
    "vue-router": "5.3.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@iconify-json/lucide": "^1.2.137",
    "@types/better-sqlite3": "^9.6.0",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^24.19.0",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vue/tsconfig": "^0.9.1",
    "concurrently": "^10.0.5",
    "dotenv": "^17.4.2",
    "drizzle-kit": "1.0.0-rc.4",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^17.12.0",
    "prettier": "^3.9.9",
    "supertest": "^7.3.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.1",
    "vitest": "^4.1.11",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.11"
  }
}

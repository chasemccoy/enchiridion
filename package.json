{
  "name": "enchiridion",
  "version": "0.1.0",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=24"
  },
  "description": "",
  "type": "module",
  "keywords": [],
  "author": "Chase McCoy",
  "license": "MIT",
  "bin": {
    "ench": "./backend/cli/ench/bin.js"
  },
  "scripts": {
    "cli": "tsx backend/cli/ench/index.ts",
    "lint": "prettier --write . && eslint . --fix && vue-tsc -b",
    "dev:app": "vite --host",
    "dev:backend": "tsx watch backend/api/index.ts",
    "health-check": "tsx scripts/health-check.ts",
    "dev": "pnpm run health-check && concurrently \"pnpm run dev:app\" \"pnpm run dev:backend\"",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "db:push": "drizzle-kit push",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:generate": "pnpm drizzle-kit generate",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx backend/db/seed.ts",
    "db:clean": "rm -f enchiridion.db enchiridion.db-shm enchiridion.db-wal",
    "db:reset": "pnpm db:clean && pnpm db:migrate && pnpm db:seed",
    "db:check": "sqlite3 enchiridion.db 'PRAGMA integrity_check;'",
    "db:backup": "tsx scripts/backup-database.ts",
    "sync:readwise": "tsx scripts/sync-readwise.ts",
    "sync": "pnpm sync:readwise",
    "embed": "tsx scripts/embed-records.ts"
  },
  "dependencies": {
    "@iconify/vue": "^5.0.1",
    "@nuxt/ui": "^4.8.2",
    "@tanstack/vue-query": "^5.101.0",
    "@types/multer": "^2.1.0",
    "@unhead/vue": "^2.1.15",
    "@vueuse/core": "^14.3.0",
    "better-sqlite3": "^12.10.0",
    "compression": "^1.8.1",
    "cors": "^2.8.6",
    "dompurify": "^3.4.8",
    "drizzle-orm": "1.0.0-rc.4-5d5b77c",
    "express": "^5.2.1",
    "markdown-it": "^14.2.0",
    "markdown-it-mark": "^4.0.0",
    "multer": "^2.1.1",
    "openai": "^6.42.0",
    "overtype": "^2.3.10",
    "sharp": "^0.34.5",
    "slugify": "^1.6.9",
    "sqlite-vec": "^0.1.9",
    "tailwindcss": "^4.3.0",
    "trash": "^10.1.1",
    "vue": "^3.5.35",
    "vue-router": "5.1.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@iconify-json/lucide": "^1.2.111",
    "@types/better-sqlite3": "^7.6.13",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^24.7.1",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vue/tsconfig": "^0.9.1",
    "concurrently": "^10.0.3",
    "dotenv": "^17.4.2",
    "drizzle-kit": "1.0.0-rc.4-5d5b77c",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.9.2",
    "globals": "^17.6.0",
    "prettier": "^3.8.3",
    "tsx": "^4.22.4",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.60.1",
    "vite": "^8.0.16",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.3"
  }
}

{
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "compilerOptions": {
    "strict": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "types": ["node", "vite/client"],
    "paths": {
      "@db/*": ["./backend/db/*"],
      "@api/*": ["./backend/api/*"],
      "@shared/*": ["./shared/*"],
      "@app/*": ["./app/*"],
      "@integrations/*": ["./backend/integrations/*"],
      "#build/ui": ["./node_modules/@nuxt/ui/.nuxt/ui"]
    }
  },
  "include": ["app/**/*.ts", "app/**/*.tsx", "app/**/*.vue"],
  // Scratch playground, deliberately untyped — see the design-lab route in
  // app/router.ts for how it stays out of the checked program.
  "exclude": ["app/design-lab"]
}
